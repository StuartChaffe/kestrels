{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "color": {
            "custom": false,
            "customGradient": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "duotone": [],
            "palette": [
                { "name": "White",      "slug": "white",      "color": "#ffffff" },
                { "name": "Black",      "slug": "secondary",  "color": "#1C1C1C" },
                { "name": "Yellow",    	"slug": "primary",    "color": "#FFE900" }
            ]
        },
        "layout": {
            "contentSize": "50rem",
            "wideSize": "75rem"
        },
        "spacing": {
            "blockGap": null,
            "customSpacingSize": false,
            "margin": false,
            "padding": false,
            "units": []
        },
        "typography": {
            "customFontSize": false,
            "defaultFontSizes": true,
            "dropCap": false
        }
    }
}
